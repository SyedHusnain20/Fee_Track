# Copy this file to .env and fill in real values. Never commit .env itself.

ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string

# Postgres (used by both the db and api services in docker-compose.yml)
POSTGRES_USER=raabta
POSTGRES_PASSWORD=change-me
POSTGRES_DB=raabta
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backblaze B2 (year-end attendance archive + nightly backups)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
